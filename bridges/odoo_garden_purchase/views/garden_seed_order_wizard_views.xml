<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garden_seed_order_wizard_form" model="ir.ui.view">
        <field name="name">garden.seed.order.wizard.form</field>
        <field name="model">garden.seed.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Requests for Quotation">
                <field name="state" invisible="1"/>
                <group invisible="state == 'done'">
                    <field name="season_id" options="{'no_create': True}"/>
                    <field name="include_plants"/>
                </group>
                <group string="Preview" invisible="state == 'done'">
                    <field name="preview" nolabel="1" colspan="2" readonly="1"/>
                </group>
                <group string="Result" invisible="state != 'done'">
                    <field name="result" nolabel="1" colspan="2" readonly="1"/>
                </group>
                <footer>
                    <button name="action_create_rfq" string="Create Requests for Quotation" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_view_orders" string="View Requests for Quotation" type="object"
                            class="btn-primary" invisible="state != 'done' or not purchase_order_ids"
                            groups="purchase.group_purchase_user"/>
                    <field name="purchase_order_ids" invisible="1" groups="purchase.group_purchase_user"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_garden_seed_order_wizard" model="ir.actions.act_window">
        <field name="name">Create Requests for Quotation</field>
        <field name="res_model">garden.seed.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_garden_seed_order_wizard" name="Create Seed Requests for Quotation"
              parent="odoo_garden.menu_garden_planning" action="action_garden_seed_order_wizard"
              sequence="35" groups="odoo_garden.group_garden_chef"/>

    <record id="view_garden_season_form_purchase" model="ir.ui.view">
        <field name="name">garden.season.form.purchase</field>
        <field name="model">garden.season</field>
        <field name="inherit_id" ref="odoo_garden.view_garden_season_form"/>
        <field name="arch" type="xml">
            <button name="action_close" position="before">
                <button name="%(action_garden_seed_order_wizard)d" string="Create Requests for Quotation" type="action"
                        groups="odoo_garden.group_garden_chef" context="{'default_season_id': id}"/>
            </button>
        </field>
    </record>
</odoo>
