<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="garden.GardenBedOccupancy">
        <div class="o_action o_garden_occupancy_action">
            <style>
                .o_garden_occupancy_action {
                    padding: 1rem 1.5rem;
                }
                .o_garden_occupancy_header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 1rem;
                    gap: 1rem;
                }
                .o_garden_occupancy_chart {
                    display: grid;
                    grid-template-columns: 200px 1fr;
                    gap: 0.75rem;
                    align-items: start;
                }
                .o_garden_occupancy_yaxis {
                    display: grid;
                    grid-auto-rows: minmax(2.4rem, auto);
                    gap: 0.5rem;
                }
                .o_garden_occupancy_bed_label {
                    display: flex;
                    align-items: center;
                    min-height: 2.4rem;
                    padding: 0 0.5rem;
                    font-weight: 600;
                    color: #2c3e50;
                    border-right: 1px solid #dfe3e8;
                }
                .o_garden_occupancy_body {
                    position: relative;
                    width: 100%;
                }
                .o_garden_occupancy_timeline {
                    display: grid;
                    grid-auto-rows: minmax(2.4rem, auto);
                    gap: 0.5rem;
                    padding-right: 0.5rem;
                }
                .o_garden_occupancy_row {
                    position: relative;
                    min-height: 2.4rem;
                    border-bottom: 1px solid #e3e6ea;
                }
                .o_garden_occupancy_bar {
                    position: absolute;
                    top: 0.35rem;
                    height: 1.7rem;
                    border-radius: 0.8rem;
                    background: #4a8c63;
                    color: #fff;
                    display: flex;
                    align-items: center;
                    padding: 0 0.75rem;
                    font-size: 0.85rem;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
                .o_garden_occupancy_bar_label {
                    display: inline-block;
                    max-width: 100%;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
                .o_garden_occupancy_xaxis {
                    display: flex;
                    justify-content: space-between;
                    margin-top: 0.75rem;
                    color: #5f6f7a;
                    font-size: 0.85rem;
                }
                .o_garden_occupancy_axis {
                    color: #5f6f7a;
                    font-size: 0.92rem;
                }
                .o_garden_occupancy_empty {
                    padding: 1rem;
                    border: 1px solid #dfe3e8;
                    border-radius: 0.5rem;
                    background: #f7f9fb;
                }
            </style>
            <Layout display="display">
                <div class="o_garden_occupancy_header">
                    <h1>Occupation des planches</h1>
                    <div class="o_garden_occupancy_axis">
                        <span>De <t t-esc="formatDate(state.startDate)"/> à <t t-esc="formatDate(state.endDate)"/></span>
                    </div>
                </div>
                <t t-if="state.beds.length">
                    <div class="o_garden_occupancy_chart">
                        <div class="o_garden_occupancy_yaxis">
                            <t t-foreach="state.beds" t-as="bed" t-key="bed.id">
                                <div class="o_garden_occupancy_bed_label"><t t-esc="bed.name"/></div>
                            </t>
                        </div>
                        <div class="o_garden_occupancy_body">
                            <div class="o_garden_occupancy_timeline">
                                <t t-foreach="state.beds" t-as="bed" t-key="bed.id">
                                    <div class="o_garden_occupancy_row">
                                        <t t-foreach="bed.crops" t-as="crop" t-key="crop.id">
                                            <div class="o_garden_occupancy_bar" t-att-style="getBarStyle(crop)" t-att-title="crop.label + ' • ' + formatDate(crop.date_start) + ' — ' + formatDate(crop.date_end)">
                                                <span class="o_garden_occupancy_bar_label"><t t-esc="crop.label"/></span>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                            <div class="o_garden_occupancy_xaxis">
                                <span t-att-style="getTickStyle(0)"><t t-esc="formatDate(state.startDate)"/></span>
                                <span t-att-style="getTickStyle(100)"><t t-esc="formatDate(state.endDate)"/></span>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_garden_occupancy_empty">Aucune occupation de planche trouvée.</div>
                </t>
            </Layout>
        </div>
    </t>
</templates>
