<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_garden_bed_label" model="report.paperformat">
        <field name="name">Bed Labels (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_garden_bed_label" model="ir.actions.report">
        <field name="name">Bed QR Labels</field>
        <field name="model">garden.bed</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_garden.report_garden_bed_label</field>
        <field name="report_file">odoo_garden.report_garden_bed_label</field>
        <field name="print_report_name">'Bed-Labels'</field>
        <field name="paperformat_id" ref="paperformat_garden_bed_label"/>
        <field name="binding_model_id" ref="model_garden_bed"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Une étiquette par planche : nom, code et QR code qui ouvre la fiche de la planche -->
    <template id="report_garden_bed_label">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="bed">
                        <div class="o_garden_bed_label"
                             style="display:inline-block; vertical-align:top; width:48%; height:62mm; margin:1% 0.5%; padding:3mm; border:1px dashed #999; text-align:center; page-break-inside:avoid;">
                            <div style="float:right; width:62%; text-align:left;">
                                <div style="font-size:11pt; color:#555;">
                                    <span t-out="bed.site_id.name"/> › <span t-out="bed.garden_id.name"/>
                                </div>
                                <div style="font-size:20pt; font-weight:bold; line-height:1.1;" t-out="bed.name"/>
                                <div style="font-size:16pt;" t-if="bed.code">
                                    Code: <strong t-out="bed.code"/>
                                </div>
                                <div style="font-size:10pt; color:#555; margin-top:3mm;">
                                    <span t-out="bed.area" t-options="{'widget': 'float', 'precision': 1}"/> m²
                                </div>
                                <div style="font-size:8pt; color:#777; margin-top:4mm;">Scan to open the bed</div>
                            </div>
                            <img class="o_garden_bed_qr" t-att-src="bed._get_qr_image_src(200)" alt="Bed QR Code"
                                 style="width:36%; height:auto;"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
