<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_garden_compliance" model="report.paperformat">
        <field name="name">Regulatory Registers (A4 landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_garden_compliance" model="ir.actions.report">
        <field name="name">Regulatory Register</field>
        <field name="model">garden.compliance.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_garden.report_garden_compliance</field>
        <field name="report_file">odoo_garden.report_garden_compliance</field>
        <field name="print_report_name">'Register-%s' % object.register</field>
        <field name="paperformat_id" ref="paperformat_garden_compliance"/>
    </record>

    <template id="report_garden_compliance">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page o_garden_compliance">
                        <t t-if="doc.register == 'phyto'">
                            <h2>Plant Protection Register</h2>
                        </t>
                        <t t-if="doc.register == 'fertilization'">
                            <h2>Fertilization Register</h2>
                        </t>
                        <p style="font-size:9pt; color:#555;">
                            <strong t-out="doc.env.company.name"/>
                            <span t-if="doc.date_from or doc.date_to"> — period:
                                <span t-out="doc.date_from" t-options="{'widget': 'date'}"/> to
                                <span t-out="doc.date_to" t-options="{'widget': 'date'}"/></span>
                            <span t-if="doc.season_id"> — season: <span t-out="doc.season_id.name"/></span>
                            <span t-if="doc.crop_ids"> — crops: <span t-out="', '.join(doc.crop_ids.mapped('name'))"/></span>
                            — printed on <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                        </p>
                        <table t-if="doc.register == 'phyto'" class="table table-sm table-bordered o_garden_register_phyto"
                               style="font-size:8pt;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Crop</th>
                                    <th>Plot</th>
                                    <th class="text-end">Treated Area (m²)</th>
                                    <th>Product</th>
                                    <th>MA No.</th>
                                    <th class="text-end">Dose (per ha)</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Operator</th>
                                    <th>Target</th>
                                    <th>Conditions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.phyto_line_ids" t-as="line" style="page-break-inside:avoid;">
                                    <td><span t-out="line.date" t-options="{'widget': 'date'}"/></td>
                                    <td><span t-out="line.crop_id.name"/></td>
                                    <td><span t-out="line.parcel"/></td>
                                    <td class="text-end"><span t-out="line.treated_area" t-options="{'widget': 'float', 'precision': 1}"/></td>
                                    <td><span t-out="line.product_id.display_name"/></td>
                                    <td><span t-out="line.amm_number"/></td>
                                    <td class="text-end"><span t-out="line.dose" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td class="text-end">
                                        <span t-out="line.quantity" t-options="{'widget': 'float', 'precision': 3}"/>
                                        <span t-out="line.uom_id.name"/>
                                    </td>
                                    <td><span t-out="line.operator"/></td>
                                    <td><span t-out="line.target"/></td>
                                    <td><span t-out="line.weather_notes"/></td>
                                </tr>
                                <tr t-if="not doc.phyto_line_ids">
                                    <td colspan="11" class="text-center text-muted">No treatment in the period.</td>
                                </tr>
                            </tbody>
                        </table>
                        <t t-if="doc.register == 'fertilization'">
                            <h4>Nitrogen Applied per Bed and Season</h4>
                            <table class="table table-sm table-bordered o_garden_register_fertilization_summary"
                                   style="font-size:9pt; width:60%;">
                                <thead>
                                    <tr>
                                        <th>Season</th>
                                        <th>Bed</th>
                                        <th class="text-end">Nitrogen (kg N)</th>
                                        <th class="text-end">Nitrogen (kg N/ha)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc._get_fertilization_summary()" t-as="group">
                                        <td><span t-out="group[0].name"/></td>
                                        <td><span t-out="group[1].name"/></td>
                                        <td class="text-end"><span t-out="group[2]" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                        <td class="text-end"><span t-out="group[3]" t-options="{'widget': 'float', 'precision': 1}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <h4>Application Details</h4>
                            <table class="table table-sm table-bordered o_garden_register_fertilization" style="font-size:8pt;">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Season</th>
                                        <th>Bed</th>
                                        <th>Crop</th>
                                        <th class="text-end">Area (m²)</th>
                                        <th>Fertilizer</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">N (%)</th>
                                        <th class="text-end">kg N</th>
                                        <th class="text-end">kg N/ha</th>
                                        <th>Remark</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.fertilization_line_ids" t-as="line" style="page-break-inside:avoid;">
                                        <td><span t-out="line.date" t-options="{'widget': 'date'}"/></td>
                                        <td><span t-out="line.season_id.name"/></td>
                                        <td><span t-out="line.bed_id.name"/></td>
                                        <td><span t-out="line.crop_id.name"/></td>
                                        <td class="text-end"><span t-out="line.treated_area" t-options="{'widget': 'float', 'precision': 1}"/></td>
                                        <td><span t-out="line.product_id.display_name"/></td>
                                        <td class="text-end">
                                            <span t-out="line.quantity" t-options="{'widget': 'float', 'precision': 3}"/>
                                            <span t-out="line.uom_id.name"/>
                                        </td>
                                        <td class="text-end"><span t-out="line.nitrogen_content" t-options="{'widget': 'float', 'precision': 1}"/></td>
                                        <td class="text-end"><span t-out="line.nitrogen_kg" t-options="{'widget': 'float', 'precision': 3}"/></td>
                                        <td class="text-end"><span t-out="line.nitrogen_per_ha" t-options="{'widget': 'float', 'precision': 1}"/></td>
                                        <td><span t-out="line.note"/></td>
                                    </tr>
                                    <tr t-if="not doc.fertilization_line_ids">
                                        <td colspan="11" class="text-center text-muted">No fertilization in the period.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
