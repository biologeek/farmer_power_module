<odoo>
    <record id="view_garden_farm_tree" model="ir.ui.view">
        <field name="name">garden.farm.tree</field>
        <field name="model">garden.farm</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_garden_farm_form" model="ir.ui.view">
        <field name="name">garden.farm.form</field>
        <field name="model">garden.farm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name" string="Name" placeholder="Farm name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="site_ids" string="Sites" placeholder="Sites attached to this farm"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_garden_farm_search" model="ir.ui.view">
        <field name="name">garden.farm.search</field>
        <field name="model">garden.farm</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_garden_farm" model="ir.actions.act_window">
        <field name="name">Farms</field>
        <field name="res_model">garden.farm</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first farm
            </p>
        </field>
    </record>
</odoo>
