<odoo>
    <record id="view_garden_crop_catalog_tree" model="ir.ui.view">
        <field name="name">garden.crop.catalog.tree</field>
        <field name="model">garden.crop.catalog</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mode_culture"/>
                <field name="distance"/>
                <field name="nb_rangs"/>
                <field name="duree_previsionnelle"/>
            </list>
        </field>
    </record>
    <record id="view_garden_crop_catalog_form" model="ir.ui.view">
        <field name="name">garden.crop.catalog.form</field>
        <field name="model">garden.crop.catalog</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom" placeholder="Nom de la culture"/>
                    </group>
                    <group>
                        <field name="mode_culture" string="Mode de culture" placeholder="Sélectionnez le mode de culture"/>
                    </group>
                    <group>
                        <field name="distance" string="Distance (cm)" placeholder="Distance entre plants (cm)"/>
                    </group>
                    <group>
                        <field name="nb_rangs" string="Nombre de rangs" placeholder="Nombre de rangs"/>
                    </group>
                    <group>
                        <field name="duree_previsionnelle" string="Durée prévisionnelle" placeholder="Durée prévisionnelle (jours)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_garden_crop_catalog" model="ir.actions.act_window">
        <field name="name">Catalogue de cultures</field>
        <field name="res_model">garden.crop.catalog</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première culture
            </p>
        </field>
    </record>
</odoo>
