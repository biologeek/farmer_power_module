<odoo>
    <record id="view_garden_statistics" model="ir.ui.view">
        <field name="name">garden.statistics</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <list string="Statistiques de production">
                <field name="template_id"/>
                <field name="bed_id"/>
                <field name="quantity_harvested"/>
                <field name="value_harvested"/>
            </list>
        </field>
    </record>   
    <record id="action_garden_statistics" model="ir.actions.act_window">
        <field name="name">Statistiques</field>
        <field name="res_model">garden.crop</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_garden_statistics"/>
    </record>
    <record id="action_garden_bed_occupancy" model="ir.actions.client">
        <field name="name">Plan de culture</field>
        <field name="tag">garden_bed_occupancy</field>
    </record>
    <record id="action_garden_statistics_charts" model="ir.actions.client">
        <field name="name">Statistiques (Graphiques)</field>
        <field name="tag">garden_statistics</field>
    </record>
    <record id="action_garden_production_statistics" model="ir.actions.client">
        <field name="name">Production</field>
        <field name="tag">garden_production_statistics</field>
    </record>
</odoo>
