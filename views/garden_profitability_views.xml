<odoo>
    <record id="view_garden_profitability_list" model="ir.ui.view">
        <field name="name">garden.crop.profitability.list</field>
        <field name="model">garden.crop.profitability</field>
        <field name="arch" type="xml">
            <list string="Rentabilité par culture" create="0" edit="0" delete="0"
                  decoration-danger="margin &lt; 0" default_order="margin_per_hour desc">
                <header>
                    <button name="action_refresh" type="object" string="Actualiser" display="always" class="btn-primary"/>
                </header>
                <field name="crop_id"/>
                <field name="season_id" optional="show"/>
                <field name="site_id" optional="hide"/>
                <field name="bed_id" optional="show"/>
                <field name="species_id" optional="show"/>
                <field name="variety_id" optional="hide"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="area" sum="Total" optional="show"/>
                <field name="occupation_days" optional="hide"/>
                <field name="hours" widget="float_time" sum="Total" optional="show"/>
                <field name="labour_cost" sum="Total" optional="show"/>
                <field name="input_cost" sum="Total" optional="show"/>
                <field name="fixed_cost" sum="Total" optional="hide"/>
                <field name="harvested_qty" sum="Total" optional="show"/>
                <field name="yield_per_m2" optional="hide"/>
                <field name="loss_rate" widget="percentage" optional="hide"/>
                <field name="revenue" sum="Total" optional="show"/>
                <field name="margin" sum="Total" optional="show"/>
                <field name="margin_per_hour" optional="show"/>
                <field name="margin_per_m2" optional="show"/>
                <field name="expected_yield_qty" optional="hide"/>
                <field name="expected_revenue" optional="hide"/>
                <field name="expected_hours" widget="float_time" optional="hide"/>
                <field name="yield_gap" optional="hide"/>
                <field name="revenue_gap" optional="hide"/>
                <field name="hours_gap" widget="float_time" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_garden_profitability_pivot" model="ir.ui.view">
        <field name="name">garden.crop.profitability.pivot</field>
        <field name="model">garden.crop.profitability</field>
        <field name="arch" type="xml">
            <pivot string="Rentabilité" disable_linking="1">
                <field name="species_id" type="row"/>
                <field name="season_id" type="col"/>
                <field name="revenue" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="margin_per_hour" type="measure"/>
                <field name="margin_per_m2" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_garden_profitability_graph" model="ir.ui.view">
        <field name="name">garden.crop.profitability.graph</field>
        <field name="model">garden.crop.profitability</field>
        <field name="arch" type="xml">
            <graph string="Rentabilité" type="bar">
                <field name="species_id"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_garden_profitability_search" model="ir.ui.view">
        <field name="name">garden.crop.profitability.search</field>
        <field name="model">garden.crop.profitability</field>
        <field name="arch" type="xml">
            <search>
                <field name="crop_id"/>
                <field name="season_id"/>
                <field name="site_id"/>
                <field name="garden_id"/>
                <field name="bed_id"/>
                <field name="species_id"/>
                <field name="variety_id"/>
                <filter name="filter_loss" string="Marge négative" domain="[('margin', '&lt;', 0)]"/>
                <filter name="filter_revenue" string="Avec chiffre d'affaires" domain="[('revenue', '!=', 0)]"/>
                <filter name="filter_done" string="Terminées" domain="[('state', '=', 'done')]"/>
                <filter name="filter_ongoing" string="En cours" domain="[('state', 'in', ('sown', 'in_place', 'harvesting'))]"/>
                <group>
                    <filter name="group_season" string="Saison" context="{'group_by': 'season_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_garden" string="Îlot" context="{'group_by': 'garden_id'}"/>
                    <filter name="group_bed" string="Planche" context="{'group_by': 'bed_id'}"/>
                    <filter name="group_species" string="Espèce" context="{'group_by': 'species_id'}"/>
                    <filter name="group_family" string="Famille botanique" context="{'group_by': 'family'}"/>
                    <filter name="group_variety" string="Variété" context="{'group_by': 'variety_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_garden_profitability" model="ir.actions.act_window">
        <field name="name">Rentabilité par culture</field>
        <field name="res_model">garden.crop.profitability</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_garden_profitability_search"/>
        <field name="context">{'search_default_group_species': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune culture à analyser
            </p>
            <p>Le rapport compare, pour chaque culture, le chiffre d'affaires attribué, les heures et les coûts. Il se recalcule à l'ouverture et avec le bouton « Actualiser ».</p>
        </field>
    </record>
    <record id="action_garden_dashboard" model="ir.actions.client">
        <field name="name">Tableau de bord de rentabilité</field>
        <field name="tag">garden_dashboard</field>
    </record>
    <!-- Ouvre le rapport après l'avoir actualisé. -->
    <record id="action_garden_profitability_open" model="ir.actions.server">
        <field name="name">Rentabilité par culture</field>
        <field name="model_id" ref="model_garden_crop_profitability"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
    <record id="ir_cron_garden_profitability" model="ir.cron">
        <field name="name">Maraîchage : actualiser le rapport de rentabilité</field>
        <field name="model_id" ref="model_garden_crop_profitability"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
