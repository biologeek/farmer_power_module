<odoo>
    <record id="view_garden_traceability_tree" model="ir.ui.view">
        <field name="name">garden.traceability.tree</field>
        <field name="model">garden.traceability</field>
        <field name="arch" type="xml">
            <list>
                <field name="seed_lot"/>
                <field name="client"/>
                <field name="action_id"/>
            </list>
        </field>
    </record>
    <record id="view_garden_traceability_form" model="ir.ui.view">
        <field name="name">garden.traceability.form</field>
        <field name="model">garden.traceability</field>
        <field name="arch" type="xml">
            <form>
                <field name="seed_lot" placeholder="Lot de semences"/>
                <field name="client" placeholder="Client / destinataire"/>
                <field name="action_id" placeholder="Action liée"/>
            </form>
        </field>
    </record>
    <record id="action_garden_traceability" model="ir.actions.act_window">
        <field name="name">Traçabilité</field>
        <field name="res_model">garden.traceability</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première traçabilité
            </p>
        </field>
    </record>
</odoo>
