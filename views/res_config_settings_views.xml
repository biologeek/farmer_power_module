<odoo>
    <record id="res_config_settings_view_form_garden" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.garden</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Maraîchage" string="Maraîchage" name="odoo_garden" groups="odoo_garden.group_garden_manager">
                    <block title="Planification" name="garden_planning_setting_container">
                        <setting string="Marge de semis" id="garden_seed_margin_setting"
                                 help="Surplus de graines prévu en plus du taux de germination pour calculer les besoins en semences.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="garden_seed_margin" class="oe_inline"/> %
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_garden_settings" model="ir.actions.act_window">
        <field name="name">Paramètres</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'odoo_garden', 'bin_size': False}</field>
    </record>
</odoo>
