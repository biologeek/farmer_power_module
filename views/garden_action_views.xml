<odoo>
    <record id="view_garden_action_tree" model="ir.ui.view">
        <field name="name">garden.action.tree</field>
        <field name="model">garden.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="type_id"/>
                <field name="date"/>
                <field name="bed_id"/>
                <field name="crop_id"/>
            </list>
        </field>
    </record>
    <record id="view_garden_action_form" model="ir.ui.view">
        <field name="name">garden.action.form</field>
        <field name="model">garden.action</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type_id" string="Action" placeholder="Type d'action (ex: arrosage, binage)"/>
                    </group>
                    <group>
                        <field name="date" string="Date" placeholder="Date de l'action (jj-mm-aaaa)"/>
                    </group>
                    <group>
                        <field name="duration" string="Durée (minutes)" placeholder="Durée de l'action (minutes)"/>
                    </group>
                    <group>
                        <field name="bed_id" string="Planche" placeholder="Planche concernée"/>
                    </group>
                    <group>
                        <field name="crop_id" string="Culture" placeholder="Culture concernée"/>
                    </group>
                    <group>
                        <field name="description" string="Description" placeholder="Détails de l'action"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_garden_action" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">garden.action</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première action
            </p>
        </field>
    </record>
</odoo>
