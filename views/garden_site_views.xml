<odoo>
    <record id="view_garden_site_tree" model="ir.ui.view">
        <field name="name">garden.site.tree</field>
        <field name="model">garden.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="farm_id"/>
            </list>
        </field>
    </record>
    <record id="view_garden_site_form" model="ir.ui.view">
        <field name="name">garden.site.form</field>
        <field name="model">garden.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom" placeholder="Nom du site"/>
                    </group>
                    <group>
                        <field name="farm_id" string="Ferme" placeholder="Ferme parent"/>
                    </group>
                    <group>
                        <field name="garden_ids" string="Jardins" placeholder="Jardins du site"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_garden_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">garden.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier site
            </p>
        </field>
    </record>
</odoo>
