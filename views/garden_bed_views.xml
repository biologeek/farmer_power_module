<odoo>
    <record id="view_garden_bed_tree" model="ir.ui.view">
        <field name="name">garden.bed.tree</field>
        <field name="model">garden.bed</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="garden_id"/>
                <field name="site_id" optional="show"/>
                <field name="length" optional="show"/>
                <field name="width" optional="show"/>
                <field name="area" sum="Total"/>
                <field name="soil_type" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_garden_bed_form" model="ir.ui.view">
        <field name="name">garden.bed.form</field>
        <field name="model">garden.bed</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_operation" string="New Operation" type="object" class="btn-primary"/>
                    <button name="%(odoo_garden.action_report_garden_bed_label)d" string="QR Label" type="action"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_operations" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="operation_count" widget="statinfo" string="Operations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" string="Name" placeholder="Bed name"/>
                            <field name="code"/>
                            <field name="garden_id" string="Block" placeholder="Parent Block"/>
                            <field name="site_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="length"/>
                            <field name="width"/>
                            <field name="area"/>
                            <field name="soil_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Crops" name="crops">
                            <field name="crop_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="template_id"/>
                                    <field name="occupation_start"/>
                                    <field name="occupation_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Crops in Place" name="current_crops">
                            <field name="current_crop_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="template_id"/>
                                    <field name="occupation_start"/>
                                    <field name="occupation_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Operations" name="operations">
                            <field name="operation_ids" readonly="1" placeholder="Operations targeting this bed">
                                <list>
                                    <field name="name"/>
                                    <field name="type_id"/>
                                    <field name="planned_date"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_garden_bed_search" model="ir.ui.view">
        <field name="name">garden.bed.search</field>
        <field name="model">garden.bed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]" string="Name or code"/>
                <field name="garden_id"/>
                <field name="site_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_garden" string="Block" context="{'group_by': 'garden_id'}"/>
                    <filter name="group_soil" string="Soil Type" context="{'group_by': 'soil_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_garden_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">garden.bed</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first bed
            </p>
        </field>
    </record>
</odoo>
