<odoo>
    <record id="view_garden_postprocess_tree" model="ir.ui.view">
        <field name="name">garden.postprocess.tree</field>
        <field name="model">garden.postprocess</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="action_id"/>
            </list>
        </field>
    </record>
    <record id="view_garden_postprocess_form" model="ir.ui.view">
        <field name="name">garden.postprocess.form</field>
        <field name="model">garden.postprocess</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Nom" placeholder="Nom du post-process"/>
                    </group>
                    <group>
                        <field name="date" string="Date" placeholder="Date du post-process (jj-mm-aaaa)"/>
                    </group>
                    <group>
                        <field name="action_id" string="Action" placeholder="Action associée"/>
                    </group>
                    <group>
                        <field name="description" string="Description" placeholder="Détails"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_garden_postprocess" model="ir.actions.act_window">
        <field name="name">Post-process</field>
        <field name="res_model">garden.postprocess</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier post-process
            </p>
        </field>
    </record>
</odoo>
