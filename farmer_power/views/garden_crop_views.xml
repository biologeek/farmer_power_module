<odoo>
    <record id="view_garden_crop_tree" model="ir.ui.view">
        <field name="name">garden.crop.tree</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <list decoration-warning="has_overlap or has_rotation_conflict">
                <field name="name"/>
                <field name="season_id" optional="show"/>
                <field name="template_id"/>
                <field name="bed_id"/>
                <field name="bed_share" optional="hide"/>
                <field name="area" optional="show" sum="Total"/>
                <field name="planned_sowing_date" optional="show"/>
                <field name="planned_transplant_date" optional="hide"/>
                <field name="planned_harvest_start" optional="show"/>
                <field name="planned_harvest_end" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="harvested_qty" optional="show" sum="Total"/>
                <field name="loss_rate" optional="hide" widget="percentage"/>
                <field name="overlap_share" optional="hide" string="Max Occupation (%)"/>
                <field name="has_overlap" optional="show"/>
                <field name="has_rotation_conflict" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'" decoration-success="state in ('sown', 'in_place', 'harvesting')"
                       decoration-muted="state in ('done', 'cancelled')"/>
            </list>
        </field>
    </record>
    <record id="view_garden_crop_form" model="ir.ui.view">
        <field name="name">garden.crop.form</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan_from_sowing" string="Recompute from Sowing" type="object"
                            invisible="not planned_sowing_date or state in ('done', 'cancelled')"/>
                    <button name="action_plan_from_harvest" string="Recompute from Harvest" type="object"
                            invisible="not planned_harvest_start or state in ('done', 'cancelled')"/>
                    <button name="action_generate_operations" string="Generate Operations" type="object"
                            invisible="not planned_sowing_date or state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"
                           statusbar_visible="planned,sown,in_place,harvesting,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_operations" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="operation_count" widget="statinfo" string="Operations"/>
                        </button>
                        <button name="action_view_harvests" type="object" class="oe_stat_button" icon="fa-shopping-basket"
                                invisible="not harvested_qty">
                            <field name="harvested_qty" widget="statinfo" string="Harvested (kg)"/>
                        </button>
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-money"
                                groups="farmer_power.group_garden_chef">
                            <field name="sale_line_count" widget="statinfo" string="Sales"/>
                        </button>
                        <button name="action_view_losses" type="object" class="oe_stat_button" icon="fa-trash-o">
                            <field name="loss_count" widget="statinfo" string="Losses"/>
                        </button>
                        <button name="action_garden_traceability" type="object" class="oe_stat_button" icon="fa-leaf"
                                invisible="not lot_count" string="Traceability"/>
                        <button name="action_view_lots" type="object" class="oe_stat_button" icon="fa-barcode"
                                invisible="not lot_count">
                            <field name="lot_count" widget="statinfo" string="Lots"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not overlap_warning">
                        <field name="overlap_warning" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not rotation_warning">
                        <field name="rotation_warning" nolabel="1"/>
                    </div>
                    <field name="harvest_allowed_warning" invisible="1"/>
                    <div class="alert alert-danger" role="alert" invisible="not harvest_allowed_warning">
                        Pre-harvest interval (PHI) running: harvest possible from
                        <field name="harvest_allowed_from" readonly="1" class="oe_inline fw-bold"/>.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Crop" name="crop">
                            <field name="season_id"/>
                            <field name="template_id" placeholder="Select a template"/>
                            <field name="variety_id"/>
                            <field name="species_id"/>
                            <field name="family"/>
                        </group>
                        <group string="Bed" name="bed">
                            <field name="bed_id" placeholder="Select the bed"/>
                            <field name="bed_area"/>
                            <field name="bed_share"/>
                            <field name="area"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Planning" name="planning">
                            <group>
                                <group string="Planned Dates" name="planned_dates">
                                    <field name="planned_sowing_date"/>
                                    <field name="planned_transplant_date"/>
                                    <field name="planned_harvest_start"/>
                                    <field name="planned_harvest_end"/>
                                </group>
                                <group string="Actual Dates" name="real_dates">
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="occupation_start"/>
                                    <field name="occupation_end"/>
                                    <field name="harvest_allowed_from"/>
                                </group>
                                <group string="Forecast" name="forecast">
                                    <field name="planned_plant_qty"/>
                                    <field name="expected_yield_qty"/>
                                    <field name="expected_revenue"/>
                                    <field name="planned_seed_count"/>
                                    <field name="planned_seed_qty"/>
                                </group>
                                <group string="Actual" name="actual">
                                    <field name="sowing_quantity"/>
                                    <field name="planted_quantity"/>
                                    <field name="harvested_qty"/>
                                    <field name="loss_qty"/>
                                    <field name="loss_rate" widget="percentage"/>
                                    <field name="labour_hours" widget="float_time"/>
                                    <field name="labour_cost" groups="farmer_power.group_garden_chef"/>
                                    <field name="input_cost" groups="farmer_power.group_garden_chef"/>
                                </group>
                            </group>
                        </page>
                        <page string="Operations" name="operations">
                            <button name="action_new_operation" type="object" string="New Operation"
                                    class="btn btn-secondary mb-2"/>
                            <field name="operation_ids" readonly="1" placeholder="Operations on this crop">
                                <list>
                                    <field name="name"/>
                                    <field name="type_id"/>
                                    <field name="planned_date"/>
                                    <field name="date"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <separator string="Work Allocated to the Crop"/>
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="operation_id"/>
                                    <field name="type_id"/>
                                    <field name="date"/>
                                    <field name="share"/>
                                    <field name="hours" widget="float_time" sum="Total"/>
                                    <field name="labour_cost" sum="Total" groups="farmer_power.group_garden_chef"/>
                                    <field name="input_cost" sum="Total" groups="farmer_power.group_garden_chef"/>
                                </list>
                            </field>
                        </page>
                        <page string="Harvests" name="harvests">
                            <field name="lot_ids" readonly="1" placeholder="Harvest Lots of the Crop">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_qty" sum="Total"/>
                                    <field name="create_date" string="Created on"/>
                                </list>
                            </field>
                        </page>
                        <page string="Losses" name="losses">
                            <field name="loss_ids" readonly="1" placeholder="Losses Declared on the Crop">
                                <list>
                                    <field name="date"/>
                                    <field name="stage"/>
                                    <field name="cause"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Profitability" name="profitability" groups="farmer_power.group_garden_chef">
                            <group>
                                <group string="Actual" name="profit_actual">
                                    <field name="labour_hours" widget="float_time"/>
                                    <field name="labour_cost"/>
                                    <field name="input_cost"/>
                                    <field name="fixed_cost"/>
                                    <field name="revenue"/>
                                    <field name="margin"/>
                                    <field name="margin_per_hour"/>
                                    <field name="margin_per_m2"/>
                                    <field name="harvested_qty"/>
                                </group>
                                <group string="Expected" name="profit_expected">
                                    <field name="expected_hours" widget="float_time"/>
                                    <field name="expected_yield_qty"/>
                                    <field name="expected_revenue"/>
                                </group>
                                <group string="Gap (actual - planned)" name="profit_gap">
                                    <field name="hours_gap" widget="float_time"/>
                                    <field name="yield_gap"/>
                                    <field name="revenue_gap"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Crop Notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_garden_crop_search" model="ir.ui.view">
        <field name="name">garden.crop.search</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="season_id"/>
                <field name="bed_id"/>
                <field name="template_id"/>
                <field name="variety_id"/>
                <field name="species_id"/>
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="filter_ongoing" string="In Progress" domain="[('state', 'in', ('sown', 'in_place', 'harvesting'))]"/>
                <filter name="filter_done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_season" string="Season" context="{'group_by': 'season_id'}"/>
                    <filter name="group_bed" string="Bed" context="{'group_by': 'bed_id'}"/>
                    <filter name="group_species" string="Species" context="{'group_by': 'species_id'}"/>
                    <filter name="group_variety" string="Variety" context="{'group_by': 'variety_id'}"/>
                    <filter name="group_family" string="Botanical Family" context="{'group_by': 'family'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_garden_crop_calendar" model="ir.ui.view">
        <field name="name">garden.crop.calendar</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <calendar string="Crop Calendar" date_start="planned_sowing_date" date_stop="planned_harvest_end"
                      color="species_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="bed_id"/>
                <field name="season_id"/>
                <field name="planned_harvest_start"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="action_garden_crop_calendar" model="ir.actions.act_window">
        <field name="name">Crop Calendar</field>
        <field name="res_model">garden.crop</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
        <field name="search_view_id" ref="view_garden_crop_search"/>
    </record>
    <record id="action_garden_crop" model="ir.actions.act_window">
        <field name="name">Crops</field>
        <field name="res_model">garden.crop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first crop on a bed
            </p>
        </field>
        <field name="view_id" ref="view_garden_crop_tree"/>
    </record>
    <record id="view_garden_crop_seed_pivot" model="ir.ui.view">
        <field name="name">garden.crop.seed.pivot</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <pivot string="Seed Needs">
                <field name="variety_id" type="row"/>
                <field name="season_id" type="col"/>
                <field name="area" type="measure"/>
                <field name="planned_plant_qty" type="measure"/>
                <field name="planned_seed_count" type="measure"/>
                <field name="planned_seed_qty" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_garden_crop_seed_tree" model="ir.ui.view">
        <field name="name">garden.crop.seed.tree</field>
        <field name="model">garden.crop</field>
        <field name="arch" type="xml">
            <list string="Seed Needs" create="0" edit="0">
                <field name="variety_id"/>
                <field name="name"/>
                <field name="season_id"/>
                <field name="bed_id"/>
                <field name="planned_sowing_date"/>
                <field name="area" sum="Total"/>
                <field name="planned_plant_qty" sum="Total"/>
                <field name="planned_seed_count" sum="Total"/>
                <field name="planned_seed_qty" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="action_garden_seed_needs" model="ir.actions.act_window">
        <field name="name">Seed Needs</field>
        <field name="res_model">garden.crop</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
        <field name="search_view_id" ref="view_garden_crop_search"/>
        <field name="context">{'search_default_group_variety': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No seed needs
            </p>
            <p>Needs are computed from the planned crops: area × density, germination and sowing margin.</p>
        </field>
    </record>
    <record id="action_garden_seed_needs_pivot" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_garden_crop_seed_pivot"/>
        <field name="act_window_id" ref="action_garden_seed_needs"/>
    </record>
    <record id="action_garden_seed_needs_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_garden_crop_seed_tree"/>
        <field name="act_window_id" ref="action_garden_seed_needs"/>
    </record>
</odoo>
