<odoo>
    <record id="view_garden_compliance_line_phyto_list" model="ir.ui.view">
        <field name="name">garden.compliance.line.phyto.list</field>
        <field name="model">garden.compliance.line</field>
        <field name="arch" type="xml">
            <list string="Plant Protection Register" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="crop_id"/>
                <field name="parcel"/>
                <field name="treated_area" sum="Total"/>
                <field name="product_id"/>
                <field name="amm_number"/>
                <field name="dose"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="operator" optional="show"/>
                <field name="target" optional="show"/>
                <field name="weather_notes" optional="show"/>
                <field name="season_id" optional="hide"/>
                <field name="operation_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_garden_compliance_line_fertilization_list" model="ir.ui.view">
        <field name="name">garden.compliance.line.fertilization.list</field>
        <field name="model">garden.compliance.line</field>
        <field name="arch" type="xml">
            <list string="Fertilization Register" create="0" edit="0" delete="0"
                  decoration-warning="note">
                <field name="date"/>
                <field name="season_id"/>
                <field name="bed_id"/>
                <field name="crop_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="nitrogen_content"/>
                <field name="nitrogen_kg" sum="Total"/>
                <field name="treated_area" optional="show"/>
                <field name="nitrogen_per_ha" sum="Total"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_garden_compliance_line_fertilization_pivot" model="ir.ui.view">
        <field name="name">garden.compliance.line.fertilization.pivot</field>
        <field name="model">garden.compliance.line</field>
        <field name="arch" type="xml">
            <pivot string="Nitrogen per Bed and Season" disable_linking="1">
                <field name="bed_id" type="row"/>
                <field name="season_id" type="col"/>
                <field name="nitrogen_kg" type="measure"/>
                <field name="nitrogen_per_ha" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_garden_compliance_line_organic_list" model="ir.ui.view">
        <field name="name">garden.compliance.line.organic.list</field>
        <field name="model">garden.compliance.line</field>
        <field name="arch" type="xml">
            <list string="Inputs and Organic Certification" create="0" edit="0" delete="0" decoration-danger="alert">
                <field name="date"/>
                <field name="season_id"/>
                <field name="crop_id"/>
                <field name="organic_crop"/>
                <field name="product_id"/>
                <field name="input_type" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="organic_allowed"/>
                <field name="alert" column_invisible="1"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_garden_compliance_line_search" model="ir.ui.view">
        <field name="name">garden.compliance.line.search</field>
        <field name="model">garden.compliance.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="crop_id"/>
                <field name="product_id"/>
                <field name="parcel"/>
                <field name="operator"/>
                <group>
                    <filter name="group_crop" string="Crop" context="{'group_by': 'crop_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_season" string="Season" context="{'group_by': 'season_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garden_compliance_wizard_form" model="ir.ui.view">
        <field name="name">garden.compliance.wizard.form</field>
        <field name="model">garden.compliance.wizard</field>
        <field name="arch" type="xml">
            <form string="Regulatory Register" create="0" delete="0">
                <header>
                    <button name="action_compute" string="Compute" type="object" class="btn-primary"/>
                    <button name="action_print" string="Print (PDF)" type="object" invisible="register == 'organic'"/>
                    <button name="action_open_pivot" string="Summary per Bed" type="object"
                            invisible="register != 'fertilization'"/>
                    <button name="action_export_xlsx" string="Export (XLSX)" type="object"/>
                </header>
                <sheet>
                    <field name="register" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="register" readonly="1" nolabel="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Register specific to French regulations, computed from the operations done.
                        Choose the period, the season or the crops then click "Compute", "Print"
                        or "Export".
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="season_id" options="{'no_create': True}"/>
                            <field name="crop_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="line_count" invisible="1"/>
                    <div class="alert alert-danger" role="alert" invisible="register != 'organic' or not alert_count">
                        <strong><field name="alert_count" readonly="1" class="oe_inline"/> input(s) not allowed in organic</strong>
                        used on an organic crop (red lines, "Organic Alerts" tab of the export).
                    </div>
                    <field name="phyto_line_ids" nolabel="1" invisible="register != 'phyto' or not line_count"
                           readonly="1" context="{'list_view_ref': 'farmer_power.view_garden_compliance_line_phyto_list'}"/>
                    <field name="organic_line_ids" nolabel="1" invisible="register != 'organic' or not line_count"
                           readonly="1" context="{'list_view_ref': 'farmer_power.view_garden_compliance_line_organic_list'}"/>
                    <field name="fertilization_line_ids" nolabel="1" invisible="register != 'fertilization' or not line_count"
                           readonly="1" context="{'list_view_ref': 'farmer_power.view_garden_compliance_line_fertilization_list'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garden_compliance_phyto" model="ir.actions.act_window">
        <field name="name">Plant Protection Register</field>
        <field name="res_model">garden.compliance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_register': 'phyto'}</field>
    </record>

    <record id="action_garden_compliance_fertilization" model="ir.actions.act_window">
        <field name="name">Fertilization Register</field>
        <field name="res_model">garden.compliance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_register': 'fertilization'}</field>
    </record>

    <record id="action_garden_compliance_organic" model="ir.actions.act_window">
        <field name="name">Organic Certification Export</field>
        <field name="res_model">garden.compliance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_register': 'organic'}</field>
    </record>
</odoo>
