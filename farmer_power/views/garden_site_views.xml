<odoo>
    <record id="view_garden_site_tree" model="ir.ui.view">
        <field name="name">garden.site.tree</field>
        <field name="model">garden.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="farm_id"/>
                <field name="partner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_garden_site_form" model="ir.ui.view">
        <field name="name">garden.site.form</field>
        <field name="model">garden.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" string="Name" placeholder="Site name"/>
                            <field name="farm_id" string="Farm" placeholder="Parent Farm"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group>
                        <field name="garden_ids" string="Blocks" placeholder="Blocks of the Site">
                            <list>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="culture_type"/>
                                <field name="irrigation_type"/>
                                <field name="area"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_garden_site_search" model="ir.ui.view">
        <field name="name">garden.site.search</field>
        <field name="model">garden.site</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="farm_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_farm" string="Farm" context="{'group_by': 'farm_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_garden_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">garden.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first site
            </p>
        </field>
    </record>
</odoo>
