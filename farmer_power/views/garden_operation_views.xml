<odoo>
    <record id="view_garden_operation_tree" model="ir.ui.view">
        <field name="name">garden.operation.list</field>
        <field name="model">garden.operation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('done', 'cancelled')" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="scope" optional="show"/>
                <field name="garden_main_id" optional="show"/>
                <field name="planned_date"/>
                <field name="date" optional="show"/>
                <field name="employee_ids" widget="many2many_tags" optional="show"/>
                <field name="duration" widget="float_time" optional="show"/>
                <field name="total_hours" widget="float_time" optional="show" sum="Total"/>
                <field name="labour_cost" optional="show" sum="Total" groups="farmer_power.group_garden_chef"/>
                <field name="input_cost" optional="hide" sum="Total" groups="farmer_power.group_garden_chef"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('planned', 'in_progress')" decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_garden_operation_form" model="ir.ui.view">
        <field name="name">garden.operation.form</field>
        <field name="model">garden.operation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary"
                            invisible="state not in ('planned', 'in_progress') or timer_start"/>
                    <button name="action_stop_timer" string="Stop Timer" type="object"
                            invisible="not timer_start"/>
                    <button name="action_done" string="Complete" type="object" class="btn-primary"
                            invisible="state not in ('planned', 'in_progress')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_planned" string="Reset to Planned" type="object"
                            invisible="state not in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,done"/>
                </header>
                <sheet>
                    <field name="category" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not allocation_warning">
                        <field name="allocation_warning" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not dar_warning">
                        <strong>Pre-harvest interval (PHI) not elapsed.</strong>
                        <field name="dar_warning" nolabel="1"/>
                        <span>Validation will be refused unless a manager grants a waiver.</span>
                    </div>
                    <field name="timer_start" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Operation Label"/></h1>
                    </div>
                    <group>
                        <group name="target">
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="scope"/>
                            <field name="crop_ids" widget="many2many_tags" invisible="scope != 'crop'"
                                   required="scope == 'crop'"/>
                            <field name="bed_ids" widget="many2many_tags" invisible="scope != 'bed'"
                                   required="scope == 'bed'"/>
                            <field name="garden_id" invisible="scope != 'garden'" required="scope == 'garden'"/>
                            <field name="garden_main_id" invisible="1"/>
                        </group>
                        <group name="dates">
                            <field name="planned_date"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work" name="work">
                            <group>
                                <group>
                                    <field name="employee_ids" widget="many2many_avatar_employee"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="timer_start" readonly="1" invisible="not timer_start"/>
                                </group>
                                <group>
                                    <field name="total_hours" widget="float_time"/>
                                    <field name="labour_cost" groups="farmer_power.group_garden_chef"/>
                                </group>
                            </group>
                            <field name="worker_ids" nolabel="1" placeholder="Detailed time entry per employee (optional)">
                                <list editable="bottom">
                                    <field name="employee_id" options="{'no_create': True}"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="labour_cost" groups="farmer_power.group_garden_chef" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inputs" name="inputs">
                            <field name="input_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="garden_input_type" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" options="{'no_create': True}"/>
                                    <field name="treated_area" optional="show" invisible="garden_input_type != 'phytosanitary'"/>
                                    <field name="dose" optional="show" invisible="garden_input_type != 'phytosanitary'"/>
                                    <field name="tracking" column_invisible="True"/>
                                    <field name="lot_id" required="tracking != 'none'" invisible="tracking == 'none'"
                                           options="{'no_create': True}"/>
                                    <field name="unit_cost" groups="farmer_power.group_garden_chef" optional="show"/>
                                    <field name="cost" groups="farmer_power.group_garden_chef" sum="Total"/>
                                    <field name="consumed" optional="show"/>
                                </list>
                            </field>
                            <group invisible="not input_ids">
                                <field name="input_cost" groups="farmer_power.group_garden_chef"/>
                            </group>
                        </page>
                        <page string="Harvest" name="harvest" invisible="category != 'harvest'">
                            <group>
                                <field name="harvest_product_id"/>
                                <label for="harvest_qty"/>
                                <div class="o_row">
                                    <field name="harvest_qty"/>
                                    <field name="harvest_uom_id" options="{'no_create': True}"/>
                                </div>
                            </group>
                            <group string="Pre-Harvest Interval Waiver" groups="farmer_power.group_garden_manager">
                                <field name="dar_override" readonly="state == 'done'"/>
                                <field name="dar_override_reason" invisible="not dar_override"
                                       required="dar_override" readonly="state == 'done'"/>
                                <field name="dar_override_user_id" invisible="not dar_override"/>
                            </group>
                        </page>
                        <page string="Irrigation" name="irrigation" invisible="category != 'irrigation'">
                            <group>
                                <field name="water_volume"/>
                            </group>
                        </page>
                        <page string="Treatment" name="treatment" invisible="category != 'treatment'">
                            <group>
                                <field name="target"/>
                                <field name="weather_notes"/>
                            </group>
                        </page>
                        <page string="Allocation" name="allocations" invisible="state != 'done'">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="crop_id"/>
                                    <field name="bed_id"/>
                                    <field name="share"/>
                                    <field name="hours" widget="float_time" sum="Total"/>
                                    <field name="labour_cost" sum="Total" groups="farmer_power.group_garden_chef"/>
                                    <field name="input_cost" sum="Total" groups="farmer_power.group_garden_chef"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Instructions or Report"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_garden_operation_search" model="ir.ui.view">
        <field name="name">garden.operation.search</field>
        <field name="model">garden.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <field name="crop_ids"/>
                <field name="bed_ids"/>
                <field name="garden_id"/>
                <field name="employee_ids"/>
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_todo" string="To Do" domain="[('state', 'in', ('planned', 'in_progress'))]"/>
                <separator/>
                <filter name="filter_today_overdue" string="Today and Overdue"
                        domain="[('state', 'in', ('planned', 'in_progress')), ('planned_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_my_operations" string="My Operations"
                        domain="[('employee_ids.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_garden" string="Block" context="{'group_by': 'garden_main_id'}"/>
                    <filter name="group_date" string="Planned Date" context="{'group_by': 'planned_date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garden_operation_calendar" model="ir.ui.view">
        <field name="name">garden.operation.calendar</field>
        <field name="model">garden.operation</field>
        <field name="arch" type="xml">
            <calendar string="Operation Calendar" date_start="planned_date" color="type_id" mode="month"
                      quick_create="0" event_open_popup="1">
                <field name="garden_main_id"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- « Ma journée » : cartes pour téléphone, regroupées par îlot -->
    <record id="view_garden_operation_kanban" model="ir.ui.view">
        <field name="name">garden.operation.kanban</field>
        <field name="model">garden.operation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="garden_main_id" group_create="0" group_delete="0"
                    group_edit="0" quick_create="0" records_draggable="0" create="0">
                <field name="state"/>
                <field name="timer_start"/>
                <field name="planned_date"/>
                <field name="type_icon"/>
                <field name="requires_quantity"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <i t-att-class="'fa fa-fw fa-lg me-2 text-primary ' + (record.type_icon.raw_value or 'fa-wrench')" title="Operation Type" role="img"/>
                            <div class="flex-grow-1">
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted">
                                    <field name="planned_date" widget="remaining_days"
                                           invisible="state not in ('planned', 'in_progress')"/>
                                    <span t-if="record.duration.raw_value"> - <field name="duration" widget="float_time"/></span>
                                </div>
                            </div>
                            <span t-if="record.timer_start.raw_value" class="badge text-bg-warning">
                                <i class="fa fa-clock-o" title="Timer running" role="img"/> Timer
                            </span>
                        </div>
                        <footer class="pt-2">
                            <field name="employee_ids" widget="many2many_avatar_employee"/>
                            <div class="ms-auto d-flex gap-2">
                                <button t-if="(record.state.raw_value == 'planned' or record.state.raw_value == 'in_progress') and !record.timer_start.raw_value"
                                        name="action_start" type="object" class="btn btn-sm btn-primary">
                                    Start
                                </button>
                                <button t-if="record.state.raw_value == 'planned' or record.state.raw_value == 'in_progress'"
                                        name="action_done" type="object" class="btn btn-sm btn-success">
                                    Complete
                                </button>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_garden_operation" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">garden.operation</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_garden_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first operation
            </p>
            <p>An operation is a piece of work (sowing, watering, harvest...) on a crop, beds or a block.</p>
        </field>
    </record>

    <record id="action_garden_operation_calendar" model="ir.actions.act_window">
        <field name="name">Operation Calendar</field>
        <field name="res_model">garden.operation</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
        <field name="search_view_id" ref="view_garden_operation_search"/>
    </record>

    <record id="action_garden_operation_today" model="ir.actions.act_window">
        <field name="name">My Day</field>
        <field name="res_model">garden.operation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_garden_operation_search"/>
        <field name="context">{'search_default_filter_today_overdue': 1, 'search_default_filter_my_operations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing to do for now
            </p>
            <p>The planned operations of the day and overdue ones assigned to you appear here. Remove the "My Operations" filter to see those of the whole team.</p>
        </field>
    </record>
    <!-- Statistiques de temps : heures réparties sur les cultures (remplacent l'ancien écran Chart.js) -->
    <record id="view_garden_time_pivot" model="ir.ui.view">
        <field name="name">garden.operation.allocation.pivot</field>
        <field name="model">garden.operation.allocation</field>
        <field name="arch" type="xml">
            <pivot string="Work Time" disable_linking="1">
                <field name="category" type="row"/>
                <field name="template_id" type="col"/>
                <field name="hours" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>
    <record id="view_garden_time_graph" model="ir.ui.view">
        <field name="name">garden.operation.allocation.graph</field>
        <field name="model">garden.operation.allocation</field>
        <field name="arch" type="xml">
            <graph string="Work Time" type="bar" stacked="1">
                <field name="category"/>
                <field name="template_id"/>
                <field name="hours" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_garden_time_search" model="ir.ui.view">
        <field name="name">garden.operation.allocation.search</field>
        <field name="model">garden.operation.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="crop_id"/>
                <field name="type_id"/>
                <field name="bed_id"/>
                <field name="template_id"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_type" string="Operation Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                    <filter name="group_bed" string="Bed" context="{'group_by': 'bed_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_garden_time_statistics" model="ir.actions.act_window">
        <field name="name">Work Time</field>
        <field name="res_model">garden.operation.allocation</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_garden_time_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No labor time allocated</p>
            <p>Hours appear when operations are done.</p>
        </field>
    </record>
</odoo>
