<odoo>
    <record id="view_garden_loss_tree" model="ir.ui.view">
        <field name="name">garden.loss.list</field>
        <field name="model">garden.loss</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="crop_id"/>
                <field name="bed_id" optional="show"/>
                <field name="stage"/>
                <field name="cause"/>
                <field name="product_id" optional="hide"/>
                <field name="quantity" sum="Total"/>
                <field name="uom_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_garden_loss_form" model="ir.ui.view">
        <field name="name">garden.loss.form</field>
        <field name="model">garden.loss</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scrap" type="object" class="oe_stat_button" icon="fa-trash"
                                invisible="not scrap_id" string="Stock Scrap"/>
                    </div>
                    <group>
                        <group name="main">
                            <field name="crop_id" options="{'no_create': True}" placeholder="Crop Concerned"/>
                            <field name="date"/>
                            <field name="stage" widget="radio"/>
                            <field name="cause"/>
                        </group>
                        <group name="quantity">
                            <field name="product_id" options="{'no_create': True}"
                                   invisible="stage != 'post_harvest'" required="stage == 'post_harvest'"/>
                            <label for="quantity"/>
                            <div class="o_row">
                                <field name="quantity"/>
                                <field name="uom_id" options="{'no_create': True}"/>
                            </div>
                            <field name="lot_id" invisible="not scrap_id"/>
                            <field name="scrap_id" invisible="1"/>
                            <field name="bed_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Loss Details"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_garden_loss_search" model="ir.ui.view">
        <field name="name">garden.loss.search</field>
        <field name="model">garden.loss</field>
        <field name="arch" type="xml">
            <search>
                <field name="crop_id"/>
                <field name="bed_id"/>
                <field name="product_id"/>
                <filter name="filter_pre_harvest" string="Pre-Harvest" domain="[('stage', '=', 'pre_harvest')]"/>
                <filter name="filter_post_harvest" string="Post-Harvest" domain="[('stage', '=', 'post_harvest')]"/>
                <group>
                    <filter name="group_crop" string="Crop" context="{'group_by': 'crop_id'}"/>
                    <filter name="group_bed" string="Bed" context="{'group_by': 'bed_id'}"/>
                    <filter name="group_stage" string="Step" context="{'group_by': 'stage'}"/>
                    <filter name="group_cause" string="Cause" context="{'group_by': 'cause'}"/>
                    <filter name="group_date" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_garden_loss_pivot" model="ir.ui.view">
        <field name="name">garden.loss.pivot</field>
        <field name="model">garden.loss</field>
        <field name="arch" type="xml">
            <pivot string="Losses">
                <field name="cause" type="row"/>
                <field name="stage" type="col"/>
                <field name="quantity_ref" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_garden_loss" model="ir.actions.act_window">
        <field name="name">Losses</field>
        <field name="res_model">garden.loss</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Declare your first loss
            </p>
            <p>A post-harvest loss also scraps the stock, on the crop lot.</p>
        </field>
    </record>
</odoo>
