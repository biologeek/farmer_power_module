<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="garden.GardenBedOccupancy">
        <div class="o_action o_garden_gantt">
            <Layout display="display">
                <div class="o_garden_gantt_header">
                    <h1 class="o_garden_gantt_title">Crop Plan</h1>
                    <div class="o_garden_gantt_filters">
                        <label>
                            Season
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.onFilterChange('seasonId', ev)">
                                <option value="">All Seasons</option>
                                <t t-foreach="state.seasons" t-as="season" t-key="season.id">
                                    <option t-att-value="season.id" t-att-selected="season.id === state.seasonId"><t t-esc="season.name"/></option>
                                </t>
                            </select>
                        </label>
                        <label>
                            Site
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.onFilterChange('siteId', ev)">
                                <option value="">All Sites</option>
                                <t t-foreach="state.sites" t-as="site" t-key="site.id">
                                    <option t-att-value="site.id" t-att-selected="site.id === state.siteId"><t t-esc="site.name"/></option>
                                </t>
                            </select>
                        </label>
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" t-att-checked="state.hideEmpty" t-on-change="onHideEmptyChange"/>
                            Hide Free Beds
                        </label>
                    </div>
                </div>
                <div class="o_garden_gantt_legend">
                    <t t-foreach="state.families" t-as="family" t-key="family.key">
                        <span class="o_garden_gantt_legend_item">
                            <span t-attf-class="o_garden_gantt_swatch o_garden_family_{{family.key}}"/>
                            <t t-esc="family.label"/>
                        </span>
                    </t>
                    <span class="o_garden_gantt_legend_item"><span class="o_garden_gantt_swatch o_garden_gantt_swatch_planned"/> Expected</span>
                    <span class="o_garden_gantt_legend_item"><span class="o_garden_gantt_swatch o_garden_gantt_swatch_real"/> Actual</span>
                </div>
                <t t-if="visibleGroups.length">
                    <div class="o_garden_gantt_scroll">
                        <div class="o_garden_gantt_chart">
                            <div class="o_garden_gantt_line o_garden_gantt_axis">
                                <div class="o_garden_gantt_label"/>
                                <div class="o_garden_gantt_track">
                                    <t t-foreach="months" t-as="month" t-key="month.key">
                                        <div class="o_garden_gantt_month" t-attf-style="left: {{month.left}}%; width: {{month.width}}%;">
                                            <t t-esc="month.label"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <t t-foreach="visibleGroups" t-as="group" t-key="group.id">
                                <div class="o_garden_gantt_group"><t t-esc="group.name"/></div>
                                <t t-foreach="group.beds" t-as="bed" t-key="bed.id">
                                    <div class="o_garden_gantt_line">
                                        <div class="o_garden_gantt_label" t-att-title="bed.area + ' m²'">
                                            <t t-esc="bed.name"/>
                                        </div>
                                        <div class="o_garden_gantt_track" t-att-style="rowStyle(bed)">
                                            <t t-foreach="months" t-as="month" t-key="month.key">
                                                <div class="o_garden_gantt_gridline" t-attf-style="left: {{month.left}}%;"/>
                                            </t>
                                            <div class="o_garden_gantt_today" t-att-style="todayStyle"/>
                                            <t t-foreach="bed.crops" t-as="crop" t-key="crop.id">
                                                <div t-attf-class="o_garden_gantt_bar o_garden_gantt_bar_planned o_garden_family_{{crop.family}} {{crop.state === 'cancelled' ? 'o_garden_gantt_cancelled' : ''}} {{crop.warnings.length ? 'o_garden_gantt_warning' : ''}}"
                                                     t-att-style="barStyle(crop, 'planned')" t-att-title="barTitle(crop)"
                                                     role="button" tabindex="0" t-on-click="() => this.openCrop(crop)">
                                                    <i t-if="crop.warnings.length" class="fa fa-exclamation-triangle me-1"/>
                                                    <span class="o_garden_gantt_bar_label"><t t-esc="crop.label"/></span>
                                                </div>
                                                <div t-if="crop.real_start" t-attf-class="o_garden_gantt_bar o_garden_gantt_bar_real o_garden_family_{{crop.family}}"
                                                     t-att-style="barStyle(crop, 'real')" t-att-title="barTitle(crop)"
                                                     role="button" tabindex="0" t-on-click="() => this.openCrop(crop)"/>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_garden_gantt_empty">No bed to display.</div>
                </t>
            </Layout>
        </div>
    </t>
</templates>
