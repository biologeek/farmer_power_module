<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="garden.GardenDashboardBars">
        <div t-if="!rows.length" class="text-muted">No data.</div>
        <div t-foreach="rows" t-as="row" t-key="row_index" class="o_garden_bar_row">
            <span class="o_garden_bar_label" t-esc="row.label"/>
            <span class="o_garden_bar_track">
                <span t-attf-class="o_garden_bar #{row.value &lt; 0 ? 'o_garden_bar_negative' : ''}"
                      t-attf-style="width: #{barWidth(rows, row.value)}%"/>
            </span>
            <span class="o_garden_bar_value" t-esc="format(row.value)"/>
        </div>
    </t>
    <t t-name="garden.GardenDashboard">
        <div class="o_action o_garden_dashboard">
            <Layout display="{controlPanel: {}}">
                <div class="o_garden_dashboard_body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h1 class="m-0">Profitability Dashboard</h1>
                        <button class="btn btn-primary" t-on-click="onRefresh">Refresh</button>
                    </div>
                    <t t-if="state.data">
                        <div class="o_garden_kpis mb-3">
                            <div class="o_garden_kpi"><span class="o_garden_kpi_value" t-esc="format(state.data.totals.revenue)"/><span>Revenue</span></div>
                            <div class="o_garden_kpi"><span class="o_garden_kpi_value" t-esc="format(state.data.totals.margin)"/><span>Margin</span></div>
                            <div class="o_garden_kpi"><span class="o_garden_kpi_value" t-esc="format(state.data.totals.hours)"/><span>Hours</span></div>
                            <div class="o_garden_kpi"><span class="o_garden_kpi_value" t-esc="state.data.totals.crops"/><span>Crops</span></div>
                        </div>
                        <div class="o_garden_cards">
                            <div class="o_garden_card"><h2>Margin per Species</h2><t t-call="garden.GardenDashboardBars"><t t-set="rows" t-value="state.data.margin_by_species"/></t></div>
                            <div class="o_garden_card"><h2>Hours per Operation Category</h2><t t-call="garden.GardenDashboardBars"><t t-set="rows" t-value="state.data.hours_by_category"/></t></div>
                            <div class="o_garden_card"><h2>Monthly Revenue</h2><t t-call="garden.GardenDashboardBars"><t t-set="rows" t-value="state.data.monthly_revenue"/></t></div>
                            <div class="o_garden_card">
                                <h2>10 most profitable crops per hour</h2>
                                <t t-call="garden.GardenDashboardRanking"><t t-set="rows" t-value="state.data.best"/></t>
                            </div>
                            <div class="o_garden_card">
                                <h2>10 least profitable crops per hour</h2>
                                <t t-call="garden.GardenDashboardRanking"><t t-set="rows" t-value="state.data.worst"/></t>
                            </div>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>
    <t t-name="garden.GardenDashboardRanking">
        <div t-if="!rows.length" class="text-muted">No crop with hours.</div>
        <table t-else="" class="table table-sm o_garden_ranking">
            <thead><tr><th>Crop</th><th class="text-end">Hours</th><th class="text-end">Margin</th><th class="text-end">Margin/h</th></tr></thead>
            <tbody>
                <tr t-foreach="rows" t-as="row" t-key="row.id" class="o_garden_ranking_row" t-on-click="() => this.openCrop(row)">
                    <td t-esc="row.label"/>
                    <td class="text-end" t-esc="format(row.hours)"/>
                    <td class="text-end" t-esc="format(row.margin)"/>
                    <td class="text-end" t-esc="format(row.value)"/>
                </tr>
            </tbody>
        </table>
    </t>
</templates>
